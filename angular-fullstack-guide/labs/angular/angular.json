                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/elements-lab/src/app/build-info.ts",
                  "with": "projects/elements-lab/src/app/build-info.v2.ts"
                }
              ],
              "serviceWorker": "projects/elements-lab/ngsw-config.v2.json",
